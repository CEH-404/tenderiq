########################################
# Application
########################################

NODE_ENV=development

DEBUG=true

########################################
# Browser
########################################

HEADLESS=true

BROWSER=chromium

VIEWPORT_WIDTH=1920

VIEWPORT_HEIGHT=1080


########################################
# Crawler
########################################
MAX_CONCURRENT_PAGES=10

MAX_DEPTH=5
MAX_PAGES=1000
TIMEOUT=30000

MAX_RETRIES=3

REQUEST_DELAY=1000

RESPECT_ROBOTS=true

FOLLOW_REDIRECTS=true

########################################
# Downloads
########################################

DOWNLOAD_IMAGES=true

DOWNLOAD_PDFS=true

SAVE_SCREENSHOTS=true

########################################
# Output
########################################

OUTPUT_DIR=./data

########################################
# Logging
########################################

LOG_LEVEL=info

########################################
# User Agent
########################################

USER_AGENT=TenderIQ/v1.0

########################################
# Proxy
########################################

PROXY_ENABLED=false

PROXY_SERVER=

PROXY_USERNAME=

PROXY_PASSWORD=


########################################
# Storage
########################################

DATABASE_URL=

VECTOR_DATABASE_URL=

########################################
# Security
########################################

IGNORE_SSL_ERRORS=false

########################################
# Cache
########################################

CACHE_ENABLED=true

# =====================================
# Gemini AI Configuration
# =====================================

GEMINI_API_KEY=AQ.Ab8RN6Lfh9Eo0vfd1YQTzR5kwLXWeAMOpsiPwV1MWzqyaBI_kA
# GEMINI_MODEL=gemini-3.6-flash
# ^ replaced by the GEMINI_MODEL_* chain below — gemini-3.6-flash's quota
#   is already exhausted for this key, and GeminiModelRouter blocks it
#   outright even if this line were re-enabled.
GEMINI_MODEL_PRIMARY=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-flash,gemini-3.5-flash
GEMINI_MODEL_EMERGENCY=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=64000
# GEMINI_TIMEOUT was 600000 (interpreted as SECONDS by gemini.config.js,
# i.e. ~166 hours) — effectively no timeout. Set to a real 5-minute cap.
GEMINI_TIMEOUT=300
GEMINI_MAX_RETRIES=3
GEMINI_BATCH_SIZE=100