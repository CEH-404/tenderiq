# ==========================================================
# TenderIQ — Local Development Environment Variables
# ==========================================================
#
# This file documents every environment variable required for local development.
# Do NOT add real credentials or secret values.
#
# • Variables needed by the application are documented below.
# • Never commit real secrets. Use your hosting provider's secret management.
# • Vercel production execution uses Vercel Environment Variables, not this file.
# ==========================================================

# === Application ===
NODE_ENV=development
DEBUG=true

# === Browser ===
HEADLESS=true
BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# === Crawler ===
MAX_CONCURRENT_PAGES=10
MAX_DEPTH=5
MAX_PAGES=1000
TIMEOUT=30000
MAX_RETRIES=3
REQUEST_DELAY=1000
RESPECT_ROBOTS=true
FOLLOW_REDIRECTS=true
DOWNLOAD_IMAGES=true
DOWNLOAD_PDFS=true
SAVE_SCREENSHOTS=true

# === Output ===
OUTPUT_DIR=./data

# === Logging ===
LOG_LEVEL=info
IGNORE_SSL_ERRORS=false

# === Gemini AI ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRIMARY=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-flash,gemini-3.5-flash
GEMINI_MODEL_EMERGENCY=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=64000
GEMINI_TIMEOUT=300
GEMINI_MAX_RETRIES=3

# === Security ===
SCRAPER_TRIGGER_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING

# === Database ===
DATABASE_URL=postgresql://user:password@host:port/db
DATABASE_URL_POOLED=postgresql://user:password@host:port/db/pool